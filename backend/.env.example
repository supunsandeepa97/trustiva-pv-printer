PORT=4000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trustiva_pv
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# File storage
UPLOAD_DIR=./uploads
PDF_DIR=./generated-pdfs

# Voucher defaults
VOUCHER_PREFIX=PV
VOUCHER_START=1001

# Backup DB (optional — create a free second Neon project and paste its connection string)
# If set: auto-failover to backup when primary is unreachable, and daily sync at 02:00
BACKUP_DATABASE_URL=

# Secret for manual backup trigger via POST /api/v1/backup/run
BACKUP_SECRET=change_this_to_a_random_secret
